# Proxy (định dạng host:port:username:password)
POLY_PROXY=host:port:username:password

# OpenRouter / LLM (dùng khi không có GEMINI_API_KEY)
LLM_MODEL=arcee-ai/trinity-large-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_API_KEY=your-api-key-here

# Google Gemini (nếu set, ưu tiên dùng thay OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# TAAPI (crypto signals)
TAAPI_URL=https://api.taapi.io/
TAAPI_API_KEY=your-taapi-jwt-token

# Database
DATABASE_URL=postgresql://user:password@localhost:5433/prediction_bot

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Auto real bet limits (USD notional for BUY orders)
# These are enforced by backend when calling Polymarket via /api/place-bet.
AUTO_MIN_BET_USD=1
AUTO_MAX_BET_USD=50

# Slippage tolerance for BUY orders (percentage, default 5 = 5%)
# If token price moves more than this % since AI prediction, order is rejected.
BUY_SLIPPAGE_PERCENT=5

# Ethereum / Chainlink
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Polymarket wallet (used for placing real orders and querying positions)
PRIVATE_KEY=your-eoa-private-key
PROXY_WALLET=your-proxy-wallet-address

# Real bet take-profit monitor cron interval (seconds, default 30)
REAL_BET_MONITOR_INTERVAL_SEC=30
# Sell order type when take-profit/stop-loss triggers: MARKET (default, FOK) or LIMIT
SELL_ORDER_TYPE=MARKET
